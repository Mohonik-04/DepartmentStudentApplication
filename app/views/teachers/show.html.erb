<p style="color: green"><%= notice %></p>

<%= render @teacher %>

<% if @teacher.subjects.any? %>
  <h3>List of Subjects:</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
      </tr>
    </thead>
    <tbody>
      <% @teacher.subjects.each do |subject| %>
        <tr>
          <td><%= subject.name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
